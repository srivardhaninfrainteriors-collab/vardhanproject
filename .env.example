# Public frontend settings (build-time; never put secrets in VITE_ variables).
# Blank: the Node server connects forms to its local CRM automatically.
# Static-only hosting falls back to a visitor-sent WhatsApp inquiry.
VITE_LEAD_API_URL=
SITE_BASE_PATH=/vardhanproject/
SITE_URL=https://srivardhaninfrainteriors-collab.github.io/vardhanproject/
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Private server settings. Use a deployment secret manager in production.
PORT=8791
HOST=127.0.0.1
LEADS_DB=data/leads.sqlite
# Optional legacy staff API token; leave blank when using individual CRM accounts.
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:8791,http://localhost:8791
# Enable ONLY behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Optional CRM / notification webhook. HTTPS only. No notifications without configuration.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Server-side Meta Conversions API. Configure the currently supported Graph API version.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=
META_TEST_EVENT_CODE=

# Meta Lead Ads / Facebook + Instagram Instant Forms (private server settings).
# META_GRAPH_VERSION above is shared with the optional Conversions API.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# First administrator setup only. Optional: absent values generate private local access.
# Never prefix passwords or Meta secrets with VITE_. Remove after setup.
CRM_ADMIN_NAME=
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
