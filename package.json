{
  "name": "srivardhan-infra-interiors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "check": "node scripts/check-build.mjs"
  },
  "dependencies": { "react": "^19.1.1", "react-dom": "^19.1.1" },
  "devDependencies": { "vite": "^7.3.1" }
}
